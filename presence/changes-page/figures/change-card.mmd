%% every change has the same parts, and a card missing one is not ready
flowchart LR
  W["where<br/>the page to open"] --> K["one change card"]
  H["who<br/>one role, one method"] --> K
  P["the text to paste<br/>copied from the full page"] --> K
  Y["why<br/>one to three sentences"] --> K
  D["done when<br/>something they can see signed out"] --> K
  M["no paste, or no done-when line"] -.-> Z(["the card is not ready"])
  classDef ink fill:#121212,color:#ffffff,stroke:#121212
  class Z ink
